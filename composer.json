{
    "name": "essabu/toli-laravel",
    "description": "Toli for Laravel: the SDK wired into the container, a migration that keeps one reading per subject and model, and a broadcast event when one is recorded.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "toli",
        "essabu",
        "laravel",
        "sdk",
        "decision",
        "ai"
    ],
    "homepage": "https://toli.essabu.com",
    "authors": [
        {
            "name": "Essabu",
            "email": "dev@essabu.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "essabu/toli": "^0.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/broadcasting": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Essabu\\Toli\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Essabu\\Toli\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Essabu\\Toli\\Laravel\\ToliServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true,
                "versions": {
                    "essabu/toli": "0.2.0"
                }
            }
        }
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    }
}
